#!/usr/bin/env bash

if [[ $COLORTERM = gnome-* && $TERM = xterm ]] && infocmp gnome-256color >/dev/null 2>&1; then
  export TERM='gnome-256color'
elif infocmp xterm-256color >/dev/null 2>&1; then
  export TERM='xterm-256color'
fi;

__git_get_branch_name() {
  git symbolic-ref --quiet --short HEAD 2> /dev/null || \
  git describe --all --exact-match HEAD 2> /dev/null || \
  git rev-parse --short HEAD 2> /dev/null || \
  echo '[?]'
}

__prompt_git() {
  local branch_name
  local branch_status

  git rev-parse --is-inside-work-tree &>/dev/null || return
  branch_name=$(__git_get_branch_name)

  # Check of unpushed commits
  if [ ! -z "$(git log @{upstream}..HEAD 2>/dev/null)" ]; then
    branch_status='^'

  # Check for uncommitted changes in the index.
  elif ! $(git diff --quiet --ignore-submodules --cached); then
    branch_status='+'

  # Check for unstaged changes.
  elif ! $(git diff-files --quiet --ignore-submodules --); then
    branch_status='!'

  # Check for untracked files.
  elif [ -n "$(git ls-files --others --exclude-standard)" ]; then
    branch_status='?'

  # Check for stashed files.
  elif $(git rev-parse --verify refs/stash &>/dev/null); then
    branch_status='*'
  fi

  echo -e "${1}${branch_name}${2}${branch_status}"
}

if tput setaf 1 &> /dev/null; then
  tput sgr0
  bold=$(tput bold)
  reset=$(tput sgr0)
  black=$(tput setaf 0)
  blue=$(tput setaf 33)
  cyan=$(tput setaf 37)
  green=$(tput setaf 64)
  orange=$(tput setaf 166)
  purple=$(tput setaf 125)
  red=$(tput setaf 124)
  violet=$(tput setaf 61)
  white=$(tput setaf 15)
  yellow=$(tput setaf 136)
else
  bold=''
  reset="\e[0m"
  black="\e[1;30m"
  blue="\e[1;34m"
  cyan="\e[1;36m"
  green="\e[1;32m"
  orange="\e[1;33m"
  purple="\e[1;35m"
  red="\e[1;31m"
  violet="\e[1;35m"
  white="\e[1;37m"
  yellow="\e[1;33m"
fi;

# Highlight the user name when logged in as root.
if [[ "${USER}" == "root" ]]; then
  user_style="${red}"
else
  user_style="${green}"
fi;

# Highlight the hostname when connected via SSH.
if [[ "${SSH_TTY}" ]]; then
  host_style="\[\h\] "
else
  host_style=""
fi;

# Set the terminal title and prompt.
PS1="\[\033]0;\W\007\]"
PS1+="${host_style}" # host, if in SSH session
PS1+="\[${bold}\]"
PS1+="\[${user_style}\]\u " # username
PS1+="\[${blue}\]\w" # working directory
PS1+="\$(__prompt_git \" \[${reset}${orange}\]\" \"\[${bold}${purple}\]\")" # git details
PS1+="\[${reset}\] \$ "
export PS1
