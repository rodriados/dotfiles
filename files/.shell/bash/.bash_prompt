#!/usr/bin/env bash
# Dotfiles and environment variables repository.
# @file The shell prompt configuration script for bash.
# @author Rodrigo Siqueira <me@rodriados.com>
# @copyright 2026-present Rodrigo Siqueira

source ~/.shell/prompt.sh

_bash_prompt_get_host() {
  if [[ "$SSH_TTY" ]];
    then echo -en "\e[37m[\h] "
  fi
}

_bash_prompt_get_user() {
  if [[ "$USER" == "root" ]];
    then echo -en "\e[38;5;124m"
    else echo -en "\e[38;5;64m"
  fi
}

_bash_prompt_report_git() {
  if [ "$SHELL_PROMPT_CURRENTLY_IN_GIT_REPOSITORY" -eq 1 ]; then
    echo -en "\e[38;5;166m$(_shell_prompt_git_reference)"
    echo -en "\e[38;5;125m$(_shell_prompt_git_repo_status) "
  fi
}

_bash_prompt_generate_theme() {
  local BASH_THEME_PROMPT_PARTS=(
    "$(_bash_prompt_get_host)"      # host
    "\$(_bash_prompt_get_user)\u "  # username
    "\[\e[38;5;33m\]\w "            # directory
    "\$(_bash_prompt_report_git)"   # git branch status
  )
  for prompt in "${BASH_THEME_PROMPT_PARTS[@]}"; do
    [[ -n "$prompt" ]] && echo -en "$prompt"
  done
}

_bash_prompt_setup() {
  _shell_prompt_git_directory_check
  PROMPT_COMMAND="$PROMPT_COMMAND;_shell_prompt_git_directory_check;"
  PS1="\[\e[1m\]$(_bash_prompt_generate_theme)\[\e[0m\]\$ "
}

_bash_prompt_setup
