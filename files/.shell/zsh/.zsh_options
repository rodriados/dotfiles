#!/usr/bin/env zsh
# Dotfiles and environment variables repository.
# @file The shell options configuration script for zsh.
# @author Rodrigo Siqueira <me@rodriados.com>
# @copyright 2026-present Rodrigo Siqueira

# Enable prompt substitution.
setopt PROMPT_SUBST

# Include local options configuration.
if [ -f ~/.zsh_options.local ]; then
  source ~/.zsh_options.local
fi
